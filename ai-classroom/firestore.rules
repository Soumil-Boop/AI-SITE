rules_version = '2';

// ============================================================
// Seek-O-Sphere — Firestore Security Rules
// Paste this into: Firebase Console → Firestore Database → Rules → Publish
//
// THREE LEVELS OF ACCESS
//   owner        — you. Sees every member, every school, every admin.
//                  'admin' is the older name for the same thing and is
//                  still accepted; see LEGACY VALUES below.
//   schooladmin  — runs one school. Sees ONLY that school's students:
//                  no other school, no online students, and no admin
//                  accounts (not even their own row).
//   student      — sees only themselves.
//
// HOW THE SCHOOL BOUNDARY IS ENFORCED
// Firestore cannot filter a list for you — it can only refuse a query
// whose results it cannot guarantee are all allowed. So every user
// document carries a `bucket` field that says, in one value, which list
// it belongs to:
//
//     'school:<schoolId>'   a student in that school
//     'online'              a student who joined without a code
//     'staff'               any admin or the owner
//
// A school admin's panel queries where('bucket','==','school:<their id>').
// Every document that query can return is, by definition, one of their
// own students — so the rule below is satisfiable and the query is
// allowed. Ask for anything else and Firestore refuses the whole query,
// not just the extra rows. One equality filter also means Firestore's
// automatic single-field index covers it: no composite index to create.
//
// `bucket` is derived, never free-form: the write rules below recompute
// it from role and schoolId and reject any document where it disagrees.
// That stops someone editing their own profile to appear in — or vanish
// from — a school's list.
//
// LEGACY VALUES, AND WHY THEY ARE HANDLED HERE
// This database predates all of the above. Two things follow from that
// and both are the rules' problem, not the data's.
//
// The owner role used to be called 'admin', and admin.html still says so
// today: isOwnerRole(r) returns true for 'owner' OR 'admin'. An earlier
// version of this file recognised only 'owner', so the panel ran the
// owner's query — every user, plus the school list — while the rules
// answered that the caller was nobody at all, and the whole panel went
// dark. Rules that disagree with the code they guard are worse than
// either alone. Both spellings are accepted here.
//
// Older profiles also predate `bucket` and `schoolId` entirely. Reading a
// field that is not there is not a false test in Firestore rules — it is
// an error, and an error denies. Every field read below therefore goes
// through .get(name, default). And an ordinary write that does not touch
// role, bucket or schoolId is not asked to justify them: stamping
// lastActive on a profile written a year ago must not fail because of a
// field that did not exist when it was created.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfileExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /* Missing rather than absent: a profile with no role at all reads as
       '' and simply matches nothing, instead of throwing and locking its
       owner out of their own account. */
    function myRole() {
      return myProfileExists() ? me().get('role', '') : '';
    }

    // You. The only role that can create schools, appoint admins, or see
    // across school boundaries. 'admin' is the same thing under its older
    // name — the panel has always treated it that way.
    function isOwner() {
      return myRole() == 'owner' || myRole() == 'admin';
    }

    // A school's own admin.
    function isSchoolAdmin() {
      return myRole() == 'schooladmin';
    }

    function mySchoolId() {
      return myProfileExists() ? me().get('schoolId', '') : '';
    }

    function myBucket() {
      return 'school:' + mySchoolId();
    }

    // The bucket a document is entitled to, worked out from its own
    // contents. A document whose stored bucket differs from this is
    // rejected on write.
    function bucketFor(d) {
      return d.get('role', 'student') != 'student'
        ? 'staff'
        : (d.get('schoolId', '') == null || d.get('schoolId', '') == ''
            ? 'online'
            : 'school:' + d.get('schoolId', ''));
    }

    /* A bucket that is absent is not a lie — it is a profile written
       before buckets existed, and sign-in backfills it. A bucket that is
       present and wrong is the thing this exists to stop. */
    function bucketIsHonest(d) {
      return !('bucket' in d) || d.get('bucket', '') == bucketFor(d);
    }

    function touches(field) {
      return field in request.resource.data.diff(resource.data).affectedKeys();
    }

    // Role decides power, schoolId decides who can see you, bucket decides
    // which list you appear in. None of the three is yours to set on
    // yourself; all three are set by the owner, by a school admin acting
    // inside their own school, or by the join-code flow at sign-up.
    function keepsOwnPrivileges() {
      return !touches('role');
    }

    /* Only a write that actually moves a school has to prove where it has
       landed. Everything else — a name, a last-active stamp, a grade — is
       none of this rule's business. */
    function standingUnchanged() {
      return !touches('bucket') && !touches('schoolId') && !touches('role');
    }

    // ── Schools ───────────────────────────────────────────────
    // Only the owner creates or edits a school. A school admin may read
    // their own school so the panel can show its name; nobody else can
    // read the list at all.
    match /schools/{schoolId} {
      // A student has to be able to read the school they belong to, or the
      // crest and name their own pages show cannot be fetched at all. Scoped
      // to their own school by the same id the profile carries, so this opens
      // nothing sideways: there is no request that returns another school.
      allow get:    if isOwner()
                    || (isSignedIn() && mySchoolId() == schoolId);
      allow list:   if isOwner();
      allow write:  if isOwner();
    }

    // ── Join codes ────────────────────────────────────────────
    // The document ID *is* the code, so a code can only be looked up by
    // someone who already knows it. `list` is owner-only, which means the
    // collection cannot be enumerated to harvest codes.
    match /joinCodes/{code} {
      allow get:    if isSignedIn();
      allow list:   if isOwner();
      allow write:  if isOwner();
    }

    // ── User profiles ─────────────────────────────────────────
    match /users/{uid} {

      // Reading one document: yourself, the owner, or a school admin
      // reading one of their own students.
      allow get: if isSignedIn() && (
        request.auth.uid == uid
        || isOwner()
        || (isSchoolAdmin() && resource.data.get('bucket', '') == myBucket())
      );

      // Listing many. The owner may list freely. A school admin's query
      // must be narrowed to their own bucket — which contains only that
      // school's students, never an admin and never another school.
      allow list: if isSignedIn() && (
        isOwner()
        || (isSchoolAdmin() && resource.data.get('bucket', '') == myBucket())
      );

      // Creating your own profile at sign-up. You may place yourself in a
      // school that exists, but you always start as a student, and the
      // bucket has to match what you claim.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.get('role', '') == 'student'
        && bucketIsHonest(request.resource.data)
        && (
          request.resource.data.get('schoolId', '') == null
          || request.resource.data.get('schoolId', '') == ''
          || exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId))
        );

      allow update: if isSignedIn() && (
        // Editing your own profile. You cannot promote yourself; and if
        // you move school, the school has to exist and the bucket has to
        // say so. A write that leaves all three alone is waved through.
        (request.auth.uid == uid
          && keepsOwnPrivileges()
          && (
            standingUnchanged()
            || (bucketIsHonest(request.resource.data)
                && (
                  request.resource.data.get('schoolId', '') == null
                  || request.resource.data.get('schoolId', '') == ''
                  || exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId))
                ))
          ))

        // The owner may change anything, including handing out roles.
        || isOwner()

        // A school admin may edit their own students — resetting progress,
        // for instance — but cannot grant a role and cannot move a student
        // out of the school and beyond their own sight.
        || (isSchoolAdmin()
            && resource.data.get('bucket', '') == myBucket()
            && request.resource.data.get('bucket', '') == myBucket()
            && keepsOwnPrivileges())
      );

      // Deleting: yourself, the owner, or a school admin deleting one of
      // their own students.
      //
      // "Yourself" is not decoration. Account settings has a Delete my
      // account button, and it removes users/<uid> before removing the
      // sign-in itself. Leaving that out — which an earlier draft did —
      // would leave anyone who pressed it half deleted: profile still
      // there, login gone, and nothing able to reach either again.
      allow delete: if isSignedIn() && (
        request.auth.uid == uid
        || isOwner()
        || (isSchoolAdmin() && resource.data.get('bucket', '') == myBucket())
      );
    }

    // ── The day planner (per user → per date) ─────────────────
    // The student's own, and their school's admin may set them work in it.
    // A school admin reaches only their own school's students — the same
    // bucket test the progress rule below uses — so this opens nothing
    // across a school boundary.
    //
    // Note what the rules cannot do: they are all-or-nothing per document,
    // and a day is one document, so an admin allowed to add an item is
    // technically able to read the whole day. The panel therefore shows an
    // admin only the items an admin set; a student's own notes to
    // themselves are round-tripped untouched and never displayed. That is
    // a decision in the code rather than a guarantee from the rules, and
    // it is written down here so nobody later mistakes it for one.
    match /planner/{uid}/{document=**} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == uid
        || isOwner()
        || (isSchoolAdmin()
            && exists(/databases/$(database)/documents/users/$(uid))
            && get(/databases/$(database)/documents/users/$(uid)).data.get('bucket', '')
                 == myBucket())
      );
    }

    // ── Syllabus (per school → per grade+subject) ──────────────
    // The topic list a school actually teaches. Every signed-in student may
    // read it — a student needs their own school's list, and reading another
    // school's topic names exposes no student data. Writing is restricted to
    // the admin of that same school, so an admin still cannot reach beyond
    // their own school; the owner may set any of them.
    match /syllabus/{schoolId}/{document=**} {
      allow read:  if isSignedIn();
      allow write: if isOwner() || (isSchoolAdmin() && mySchoolId() == schoolId);
    }

    // ── A student's own syllabus additions (per user → per grade+subject) ──
    // Topics a student adds beyond what their school teaches, plus their
    // choice to hide the standard fallback list when no school syllabus is
    // set. Mirrored here so it follows the student across devices — but
    // unlike planner and progress above, strictly the student's own: no
    // owner or admin override. It is personal study material, not
    // something staff need to see or set.
    match /ownSyllabus/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Exams (written centrally, sat by a grade) ─────────────
    // Read once per rule evaluation and cached by Firestore, so this costs
    // one document read however many clauses below mention it.
    function examOf(examId) {
      return get(/databases/$(database)/documents/exams/$(examId)).data;
    }

    // The paper is written once and stored on the exam, so every student in
    // the grade sits the same questions.
    //
    // The exam document carries the questions, the options and the hints —
    // everything needed to sit the paper, and nothing that gives it away.
    // The answers are not here. They are in key/ below.
    //
    // Who may read one is decided by its `audience` array: ['all'] for a paper
    // set to every school, or ['school:<id>', ...] for named schools. A reader
    // has to appear in it. That one field is what keeps a school out of another
    // school's papers, and it works for a list as well as a get: the client
    // queries array-contains-any ['all', 'school:<mine>'], so every document
    // the query can return is one this rule already allows. A query without
    // that constraint matches documents the rule refuses, and Firestore rejects
    // the whole query rather than quietly returning a filtered subset. There is
    // therefore no way to phrase a read that yields another school's exam.
    //
    // Only the owner writes. A school admin never authors or withdraws a paper,
    // so nothing a school admin can do reaches a school that is not theirs.
    match /exams/{examId} {
      allow get, list: if isSignedIn() && (
        isOwner()
        || 'all' in resource.data.get('audience', [])
        || ('school:' + mySchoolId()) in resource.data.get('audience', [])
      );
      allow write: if isOwner();
    }

    // ── The answer key ────────────────────────────────────────
    // Sealed until the student has handed their paper in for the last time.
    // Three things must hold together for a student to read it:
    //
    //   1. a result of their own exists for this exam — they have submitted;
    //   2. they have used every attempt the exam allows. Otherwise the key
    //      could be opened after a throwaway first try and used on the second,
    //      which is precisely what a second attempt would otherwise buy;
    //   3. the exam says answers may be shown at all.
    //
    // The honest edge that remains: on a one-attempt exam somebody can submit
    // a deliberately blank paper to unlock the key early. They would be reading
    // the answers to a test they have already handed in, and submitted answers
    // are frozen below once the attempts are spent, so the marks they handed in
    // are the marks they keep. Unlocking the key IS finishing.
    //
    // A school admin may read the key only for a paper their own school was
    // actually set — marking is their job, but only their own students' paper.
    match /exams/{examId}/key/{doc} {
      allow read: if isSignedIn() && (
        isOwner()
        || (isSchoolAdmin()
            && ('all' in examOf(examId).get('audience', [])
                || ('school:' + mySchoolId()) in examOf(examId).get('audience', [])))
        || (exists(/databases/$(database)/documents/examResults/$(examId)/students/$(request.auth.uid))
            && get(/databases/$(database)/documents/examResults/$(examId)/students/$(request.auth.uid))
                 .data.get('attemptsUsed', 1) >= examOf(examId).get('attempts', 1)
            && examOf(examId).get('revealAnswers', true) == true)
      );
      allow write: if isOwner();
    }

    // ── Requests from schools ─────────────────────────────────
    // A school admin writes in about what their class has covered and what
    // they want tested. The owner reads every school's and answers by setting
    // a paper.
    //
    // Reads are scoped by schoolId, the same field the client constrains its
    // query on. A school admin asking for anything wider matches documents
    // this rule refuses, and Firestore rejects the whole query rather than
    // returning a filtered subset — so there is no phrasing that yields
    // another school's requests.
    //
    // A school admin may only file a request against their own school, and
    // only as 'open': they cannot post one already marked done, which would
    // let a school write its own record of what was answered.
    //
    // Status is the owner's alone. A school may withdraw a request while it
    // is still open, so a typo is not permanent, but once the owner has noted
    // or answered it the request stops being the school's to remove.
    match /examRequests/{reqId} {
      allow get, list: if isSignedIn() && (
        isOwner()
        || (isSchoolAdmin() && resource.data.get('schoolId', '') == mySchoolId())
      );

      allow create: if isSignedIn() && isSchoolAdmin()
        && request.resource.data.get('schoolId', '') == mySchoolId()
        && request.resource.data.get('status', '') == 'open';

      allow update: if isOwner();

      allow delete: if isOwner()
        || (isSchoolAdmin()
            && resource.data.get('schoolId', '') == mySchoolId()
            && resource.data.get('status', '') == 'open');
    }

    // ── Exam results (per exam → per student) ─────────────────
    // A student writes only their own result. Their school's admin may read
    // the results of their own school and no other, which is what makes a
    // set exam worth setting. The school is stamped on the result when it is
    // written, so an admin's query is one equality filter — the same shape
    // the members list uses, and satisfiable without a composite index.
    match /examResults/{examId}/students/{uid} {
      allow get: if isSignedIn() && (
        request.auth.uid == uid
        || isOwner()
        || (isSchoolAdmin() && resource.data.get('schoolId', '') == mySchoolId())
      );
      allow list: if isSignedIn() && (
        isOwner()
        || (isSchoolAdmin() && resource.data.get('schoolId', '') == mySchoolId())
      );
      // Only ever your own, and the school stamped on it has to be the one
      // your profile actually says — otherwise a result could be filed into
      // somebody else's school and show up in their teacher's list.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.get('schoolId', '') == me().get('schoolId', '');

      // Two kinds of update, and what separates them is whether an attempt
      // is left.
      //
      // While the student still has one, a resit may replace the answers — but
      // attemptsUsed has to go up, so the allowance is spent rather than resat
      // for ever. Once it reaches the exam's limit the answers freeze, and the
      // only update left is the client writing back marks it worked out after
      // reading the key. That must not double as a way to change what was
      // answered now that the answers are known.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.get('schoolId', '') == me().get('schoolId', '')
        && (
          request.resource.data.answers == resource.data.answers
          || (resource.data.get('attemptsUsed', 1) < examOf(examId).get('attempts', 1)
              && request.resource.data.get('attemptsUsed', 1)
                   > resource.data.get('attemptsUsed', 1))
        );
      allow delete: if isOwner();
    }

    // ── Practice progress (per user → per day/subject) ────────
    // Yours to write. Readable by you, by the owner, and by the admin of
    // the school you belong to — the get() below is what ties a progress
    // document back to its owner's school.
    match /progress/{uid}/{document=**} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || isOwner()
        || (isSchoolAdmin()
            && exists(/databases/$(database)/documents/users/$(uid))
            && get(/databases/$(database)/documents/users/$(uid)).data.get('bucket', '')
                 == myBucket())
      );
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Analytics ─────────────────────────────────────────────
    // Nothing may touch this from a browser. Anything not matched above is
    // already denied, so this changes no behaviour — it is here because it
    // was in the rules being replaced, and a rule that disappears silently
    // is indistinguishable from one that was forgotten.
    match /analytics/{document=**} {
      allow read, write: if false;
    }
  }
}
